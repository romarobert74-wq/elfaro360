# ============================================================
#  El Faro 360 — variables de entorno
#  Copiá este archivo como .env.local y completá los valores.
#  En Vercel: Project → Settings → Environment Variables.
# ============================================================

# Backend de datos: "mock" (default, sin backend) o "firebase"
NEXT_PUBLIC_DATA_BACKEND=mock

# ---- Firebase (solo si NEXT_PUBLIC_DATA_BACKEND=firebase) ----
# Estos valores salen de: consola de Firebase → Configuración del proyecto
# → Tus apps → SDK setup and configuration → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Selección Pictures (panoramas 360 desde Google Drive) ----
# Versión simple: solo una API key de Google + la carpeta compartida como
# "cualquiera con el enlace puede ver". Sin cuenta de servicio.
#
# API key de Google (consola de Google Cloud → APIs y servicios → Credenciales
# → Crear credenciales → Clave de API). Habilitá la "Google Drive API".
# Solo en el SERVIDOR (sin NEXT_PUBLIC_, no llega al cliente).
GOOGLE_API_KEY=
# ID de la carpeta raíz de Drive que contiene una subcarpeta por socio.
# (Se ve en la URL de la carpeta: .../folders/ESTE_ID)
DRIVE_ROOT_FOLDER_ID=
# WhatsApp de El Faro (con código de país, solo números, ej. 5492610000000).
# Es a dónde el socio envía su selección. Público (lo usa la página del socio).
NEXT_PUBLIC_PICTURES_WHATSAPP=
