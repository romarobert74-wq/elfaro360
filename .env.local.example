# ============================================================
#  El Faro 360 — variables de entorno
#  Copiá este archivo como .env.local y completá los valores.
#  En Vercel: Project → Settings → Environment Variables.
# ============================================================

# Backend de datos: "mock" (default, sin backend) o "firebase"
NEXT_PUBLIC_DATA_BACKEND=mock

# ---- Firebase (solo si NEXT_PUBLIC_DATA_BACKEND=firebase) ----
# Estos valores salen de: consola de Firebase → Configuración del proyecto
# → Tus apps → SDK setup and configuration → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
