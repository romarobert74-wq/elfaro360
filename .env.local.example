# ============================================================
#  El Faro 360 — variables de entorno
#  Copiá este archivo como .env.local y completá los valores.
#  En Vercel: Project → Settings → Environment Variables.
# ============================================================

# Backend de datos: "mock" (default, sin backend) o "firebase"
NEXT_PUBLIC_DATA_BACKEND=mock

# ---- Firebase (solo si NEXT_PUBLIC_DATA_BACKEND=firebase) ----
# Estos valores salen de: consola de Firebase → Configuración del proyecto
# → Tus apps → SDK setup and configuration → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Selección Pictures (panoramas 360 desde Google Drive) ----
# Solo en el SERVIDOR (sin prefijo NEXT_PUBLIC_, nunca llegan al cliente).
#
# ID de la carpeta raíz de Drive que contiene una subcarpeta por socio.
# (Se ve en la URL de la carpeta: .../folders/ESTE_ID)
DRIVE_ROOT_FOLDER_ID=
# Cuenta de servicio de Google (consola de Google Cloud → IAM → Cuentas de
# servicio → crear clave JSON). La MISMA cuenta se usa para Drive y Firebase Admin.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada de la cuenta de servicio. En Vercel pegá el valor tal cual, con
# los "\n" escapados; el código los convierte en saltos de línea reales.
GOOGLE_PRIVATE_KEY=
# Secreto para firmar los links públicos de cada socio (cadena larga al azar).
SELECTION_LINK_SECRET=
# (Opcional) ID del proyecto para el Admin SDK si difiere del público.
# Si no se setea, se usa NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
