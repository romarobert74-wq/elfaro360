rules_version = '2';

// Reglas de Firestore para El Faro 360.
// Pegá este contenido en: consola de Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Todo el sistema (incluida selecciones_pictures) es accesible SOLO para
    // usuarios autenticados del admin. Nada es público.
    //
    // Selección Pictures en particular:
    //  - El público (socios) NO usa Firebase: su link no autentica, así que no
    //    puede leer ni escribir esta colección directamente. "Nada público". ✔
    //  - El alta de una selección la hace la API del servidor con el Admin SDK,
    //    que no pasa por estas reglas. "Las escrituras públicas pasan solo por
    //    la API". ✔
    //  - El admin (autenticado) lee la tabla, marca como leída y cambia estado.
    //
    // Nota: el gateo por rol/permiso se hace en la app (los empleados no ven el
    // módulo). Las fichas de usuario se indexan por email, no por uid, por eso
    // el permiso fino no se expresa en estas reglas.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
