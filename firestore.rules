rules_version = '2';

// ============================================================
//  Reglas de seguridad de Firestore — El Faro 360
//
//  Modelo: SOLO usuarios autenticados (Firebase Auth) pueden leer
//  o escribir. El público NO tiene ningún acceso. Como las cuentas
//  las creás vos (super admin), únicamente tu equipo entra.
//
//  Los roles (super_admin / admin / empleado) se aplican en la UI.
//  Para endurecer aún más por rol a nivel base de datos, ver el
//  bloque comentado al final.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Datos del negocio: requieren estar logueado.
    match /{document=**} {
      allow read, write: if signedIn();
    }

    // ---- HARDENING OPCIONAL (por rol) ----
    // Requiere guardar el rol en un doc por UID: /roles/{uid} = { role: "..." }
    // y mantenerlo desde el panel. Ejemplo:
    //
    // function role() {
    //   return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role;
    // }
    // function isAdmin() { return role() in ['super_admin', 'admin']; }
    //
    // match /users/{id}      { allow read: if signedIn(); allow write: if role() == 'super_admin'; }
    // match /meta/{id}       { allow read: if signedIn(); allow write: if isAdmin(); }
    // match /{col}/{id}      { allow read: if signedIn(); allow write: if isAdmin(); }
  }
}
