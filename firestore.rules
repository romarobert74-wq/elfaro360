rules_version = '2';

// ============================================================
//  Reglas de seguridad de Firestore — El Faro 360
//  ⚠️ FASE 2 (punto de partida). Cuando integres Firebase Auth
//  real, ajustá estas reglas para validar request.auth y roles.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // --- MODO DEMO (Fase 1 → 2) ---
    // Permite lectura/escritura para poder correr el seed y la app
    // mientras todavía no hay Firebase Auth. Cambialo antes de producción.
    match /{document=**} {
      allow read, write: if true;
    }

    // --- EJEMPLO PARA PRODUCCIÓN (activar cuando haya Auth) ---
    // function signedIn() { return request.auth != null; }
    // function role() {
    //   return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    // }
    // match /{col}/{doc} {
    //   allow read:  if signedIn();
    //   allow write: if signedIn() && role() in ['super_admin', 'admin'];
    // }
  }
}
